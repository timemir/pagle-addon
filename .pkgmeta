# BigWigsMods packager config. The zip holds one folder per addon under addons/ (CORE-R1).
# Check a change with scripts/package.sh.
package-as: Pagle
enable-nolib-creation: no

# The hand-written CHANGELOG.md at the repo root, not one generated from the commits since the
# last tag (the first would list every pre-1.0 commit). It ships as Pagle/CHANGELOG.md and is the
# upload's changelog on CurseForge and Wago.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The packager copies the whole repo (minus dotfiles, so .github/ and .tools/ stay out) into Pagle/,
# so every top-level path that isn't addon code is listed here. LICENSE, NOTICE and CHANGELOG.md
# stay: they ship inside Pagle/.
ignore:
  - AGENTS.md
  - CONTEXT.md
  - README.md
  # data/ is the generator's sources; what ships is generated into addons/*/data/ (DATA-R5).
  - data
  - docs
  - probes
  - prototypes
  - scripts
  - spec
  - types
  # TGA art sources, wherever one lands: Pagle's textures ship as .blp (scripts/encode-blp.py).
  - "*.tga"

# Keys are paths under the package-as folder. Each Module adds its own line in its first
# milestone, as Pagle_QoL did in M1, Pagle_Ledger in M2, Pagle_Hunts in M5, Pagle_Stats in M6 and
# Pagle_TackleBoard in M7.
move-folders:
  Pagle/addons/Pagle: Pagle
  Pagle/addons/Pagle_Hunts: Pagle_Hunts
  Pagle/addons/Pagle_Ledger: Pagle_Ledger
  Pagle/addons/Pagle_Stats: Pagle_Stats
  Pagle/addons/Pagle_TackleBoard: Pagle_TackleBoard
  Pagle/addons/Pagle_QoL: Pagle_QoL
