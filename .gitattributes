# LF everywhere, whatever core.autocrlf says.
* text=auto eol=lf

# Pagle's rendered sounds (ANN-R74).
*.ogg binary

# Vendored libraries (Ace3, LibDeflate): stored and checked out exactly as upstream ships them,
# so scripts/update-ace3.sh --check and scripts/update-libdeflate.sh --check can compare them byte for byte.
addons/Pagle/libs/** -text

# WTF fixtures: stored and checked out exactly as the WoW client writes them, CRLF line ends included.
spec/scripts/fixtures/** -text

# The announcements art (ANN-R80): textures and bundled fonts.
*.blp binary
*.ttf binary

# The Prestige kit's lossless atlases, the web art export's source (data/art/prestige/), and the Pagle Wagers kit's
# (data/art/wagers/), with its event mark's layers as PNG.
*.tga binary
*.png binary

# The signing fixtures (spec/Pagle/fixtures/): random bytes, and the Wycheproof vectors exactly as upstream has them.
spec/Pagle/fixtures/signing/*.bin binary
spec/Pagle/fixtures/wycheproof/** -text
