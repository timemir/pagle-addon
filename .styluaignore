# Vendored libraries keep their upstream formatting (scripts/update-ace3.sh and scripts/update-libdeflate.sh own them).
addons/*/libs/
# Generated by scripts/generate-data.py (DATA-R60); nobody formats it by hand, and it still passes lint and types.
addons/Pagle/data/Catalogue.lua
addons/Pagle_Hunts/data/HuntList.lua
addons/Pagle_Hunts/data/EventList.lua
addons/*/data/Lore.lua
# One generated file per Locale's Lore (DATA-R114), named for the client code, and the busted fixture of one.
addons/*/data/Lore.[a-z][a-z][A-Z][A-Z].lua
spec/fixtures/lore-locale/
# One generated file per Locale and addon (DATA-R114): enUS.lua and, from 1.1, a file named for each other client code.
addons/*/locale/[a-z][a-z][A-Z][A-Z].lua
spec/Pagle_Ledger/fixtures/Lore.lua
# WTF fixtures are written the way the WoW client writes them, not formatted by us.
spec/scripts/fixtures/
# Generated by scripts/make-signing-fixtures.sh from openssl's answers (PUSH-R11).
spec/Pagle/fixtures/Signing.lua
# Backend-generated Recovery envelope, copied byte-for-byte for the early addon import journey.
spec/Pagle/fixtures/Recovery.lua
# Generated by scripts/measure-layout.py advances from the bundled faces.
scripts/measure-layout/advances.lua
