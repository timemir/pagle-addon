# The pinned toolchain: every tool version the check gate uses, in one place.
# scripts/setup.sh installs exactly these into .tools/; scripts/check.sh runs them from there.
# Sourced by bash, so keep it to plain NAME=value lines.
#
# To bump a tool: change its pin (and sha256), run scripts/setup.sh, then scripts/check.sh.

# The apt packages scripts/setup.sh needs on Linux (sudo apt-get install -y $SETUP_APT_PACKAGES). The Check workflow
# installs them from here too. On macOS it needs the Xcode Command Line Tools instead (xcode-select --install).
SETUP_APT_PACKAGES="build-essential unzip curl ca-certificates"

# Lua 5.1, the language of the WoW client (built from source, no LuaJIT).
LUA_VERSION=5.1.5
LUA_SHA256=2640fc56a795f29d28ef15e13c34a47e223960b0240e8cb0a82d9b0738695333

LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=245bf6ec560c042cb8948e3d661189292587c5949104677f1eecddc54dbe7e37

# Rocks, as "name version" pairs, installed in this order. Each rock's dependencies come before it, so
# LuaRocks never resolves a version on its own; setup fails if the installed set differs from this list.
# cluacov is luacov's line hook in C: luacov uses it when it's installed, the report is the same, and busted
# --coverage runs about 7x faster than with luacov's pure-Lua hook. luabitop is LuaBitOp, the `bit` library the WoW
# client ships, which Core's Simulated Size hash uses (LOG-R66); the fake client hands it to the addons it loads.
LUA_ROCKS="
argparse 0.7.2-1
luafilesystem 1.9.0-1
luacheck 1.2.0-1
lua_cliargs 3.0.2-1
luasystem 0.7.1-1
dkjson 2.11-1
say 1.4.1-3
luassert 1.9.0-1
lua-term 0.8-1
penlight 1.15.0-1
mediator_lua 1.1.2-0
busted 2.3.0-1
datafile 0.11-1
luacov 0.17.0-1
cluacov 1.0.0-1
luabitop 1.0.2-3
"

# StyLua, the static musl build (no glibc floor). Each tool below has one sha256 per platform of the same version:
# the plain name is the x86_64 Linux asset, MACOS_ARM64 and MACOS_X64 are the macOS ones (Apple silicon and Intel).
STYLUA_VERSION=2.6.0
STYLUA_SHA256=48ee7db28346f96f4bd545e190ab080a88a7b5a664e97649cf5d5c60426f402d
STYLUA_MACOS_ARM64_SHA256=dab9b66d340ca5ffc8225211f1dcf89b84783e09b8cbec8c518497eba81f3c42
STYLUA_MACOS_X64_SHA256=90779aa873837b2dff8eb3361bd27950303914c24265a59cae0a0d0629d71585

LUALS_VERSION=3.19.1
LUALS_SHA256=e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8
LUALS_MACOS_ARM64_SHA256=0bc077f4447f076b4c92c14e9fd303f5b569eda2ec74b4dca2b55f75fae2e90c
LUALS_MACOS_X64_SHA256=eb373c159cbe556711d7cd316315de2dce969bfd54b31edb7eb9cab2937f2cca

# Python for the content generator (DATA-R60): uv, the static musl build, installs CPython (3.12 for tomllib) and
# the packages into one venv, with no system Python. uv checks the CPython download against the checksum it ships
# with, so UV_VERSION pins that too (on macOS, uv's own macOS build installs the macOS CPython).
UV_VERSION=0.12.20
UV_SHA256=14114d66a094f1907af0fcbc863f34226bbb7f5e430e13dce6676ba40dcc6891
UV_MACOS_ARM64_SHA256=848fdeb602ff1a1baacd4f6c8b7bdc6cf1ad026a6d9cf59475fda17c179743ca
UV_MACOS_X64_SHA256=ac54283d211fd77cdc152b67606dbaf6406ff4ab03f3af4ae99468fa8e887141
PYTHON_VERSION=3.12.14

# Python packages, as "name version" pairs: pytest and mypy, and numpy, soundfile and SciPy for
# scripts/render-sounds.py (ANN-R74; soundfile's wheel bundles libsndfile with Ogg Vorbis, and SciPy brings the
# filters, butter, sosfilt and lfilter), and Pillow for scripts/export-web-art.py (its manylinux wheel bundles libwebp;
# it has no dependencies), and resvg-py for scripts/crate-art.py (the Curio crate's art: resvg rasterises its SVG sources;
# one wheel with the Rust library built in, no dependencies), with every dependency they have on Linux under PYTHON_VERSION, installed without resolving
# anything; setup fails if the installed set differs from this list.
PYTHON_PACKAGES="
iniconfig 2.3.0
packaging 26.3
pluggy 1.6.0
pygments 2.21.0
pytest 9.1.1
ast-serialize 0.11.2
librt 0.16.0
mypy-extensions 1.1.0
pathspec 1.1.1
typing-extensions 4.16.0
mypy 2.3.1
numpy 2.5.3
pycparser 3.0
cffi 2.1.1
soundfile 0.14.0
scipy 1.18.1
pillow 12.3.0
resvg-py 0.5.0
"

# Ketho/BlizzardInterfaceResources, branch "forever": the API dump the API presence stage checks against.
# This commit is the dump of build 1.60.1 (70338).
BIR_COMMIT=c5a49d394564f20c508c71014d6f60d9cd240c71

# Ketho/vscode-wow-api: the LuaCATS annotations the types stage checks against (only Annotations/Core is kept).
WOW_API_COMMIT=d0b5b51fac4c52c493371b9b18e66ce604ea4326

# BigWigsMods/packager: scripts/package.sh runs release.sh at PACKAGER_COMMIT, checked against its sha256, and
# .github/workflows/release.yml uses the action at the same commit. A `uses:` line can't read this file, so
# scripts/check.sh fails while the two commits differ. PACKAGER_VERSION is the tag at that commit.
PACKAGER_VERSION=2.6.1
PACKAGER_COMMIT=e50a250f8705041e40f2fa1ddcb280a686d65aa0
PACKAGER_RELEASE_SH_SHA256=59b15a8d851b09e6d0fdec702aec91331b9b49d84dbe778da6c621b48f268703
