# The pinned toolchain: every tool version the check gate uses, in one place.
# scripts/setup.sh installs exactly these into .tools/; scripts/check.sh runs them from there.
# Sourced by bash, so keep it to plain NAME=value lines.
#
# To bump a tool: change its pin (and sha256), run scripts/setup.sh, then scripts/check.sh.

# The apt packages scripts/setup.sh needs (sudo apt-get install -y $SETUP_APT_PACKAGES). The Check workflow
# installs them from here too.
SETUP_APT_PACKAGES="build-essential unzip curl ca-certificates"

# Lua 5.1, the language of the WoW client (built from source, no LuaJIT).
LUA_VERSION=5.1.5
LUA_SHA256=2640fc56a795f29d28ef15e13c34a47e223960b0240e8cb0a82d9b0738695333

LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=245bf6ec560c042cb8948e3d661189292587c5949104677f1eecddc54dbe7e37

# Rocks, as "name version" pairs, installed in this order. Each rock's dependencies come before it, so
# LuaRocks never resolves a version on its own; setup fails if the installed set differs from this list.
LUA_ROCKS="
argparse 0.7.2-1
luafilesystem 1.9.0-1
luacheck 1.2.0-1
lua_cliargs 3.0.2-1
luasystem 0.7.1-1
dkjson 2.11-1
say 1.4.1-3
luassert 1.9.0-1
lua-term 0.8-1
penlight 1.15.0-1
mediator_lua 1.1.2-0
busted 2.3.0-1
datafile 0.11-1
luacov 0.17.0-1
"

# StyLua, the static musl build (no glibc floor).
STYLUA_VERSION=2.6.0
STYLUA_SHA256=48ee7db28346f96f4bd545e190ab080a88a7b5a664e97649cf5d5c60426f402d

LUALS_VERSION=3.19.1
LUALS_SHA256=e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8

# Ketho/BlizzardInterfaceResources, branch "forever": the API dump the API presence stage checks against.
# This commit is the dump of build 1.60.1 (70338).
BIR_COMMIT=c5a49d394564f20c508c71014d6f60d9cd240c71

# Ketho/vscode-wow-api: the LuaCATS annotations the types stage checks against (only Annotations/Core is kept).
WOW_API_COMMIT=d0b5b51fac4c52c493371b9b18e66ce604ea4326

# BigWigsMods/packager: scripts/package.sh runs release.sh at PACKAGER_COMMIT, checked against its sha256, and
# .github/workflows/release.yml uses the action at the same commit. A `uses:` line can't read this file, so
# scripts/check.sh fails while the two commits differ. PACKAGER_VERSION is the tag at that commit.
PACKAGER_VERSION=2.6.1
PACKAGER_COMMIT=e50a250f8705041e40f2fa1ddcb280a686d65aa0
PACKAGER_RELEASE_SH_SHA256=59b15a8d851b09e6d0fdec702aec91331b9b49d84dbe778da6c621b48f268703
