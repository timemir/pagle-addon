{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"runtime.version": "Lua 5.1",
	"runtime.builtin": {
		"basic": "disable",
		"debug": "disable",
		"io": "disable",
		"math": "disable",
		"os": "disable",
		"package": "disable",
		"string": "disable",
		"table": "disable",
		"utf8": "disable"
	},
	"workspace.library": [
		".tools/wow-api/Annotations/Core",
		"types",
		"addons/Pagle/libs",
		"${3rd}/busted/library",
		"${3rd}/luassert/library"
	],
	"workspace.ignoreDir": [".tools", ".release", "addons/Pagle/libs", "scripts", "spec/scripts/fixtures", "probes", "prototypes"],
	"workspace.checkThirdParty": false
}
